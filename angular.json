{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "de9d699f-ce64-4c4d-a3cd-d0c9c63743c1"
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "raven": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "allowedCommonJsDependencies": [ "raf", "core-js", "dompurify", "html2canvas", "rgbcolor", "jspdf-autotable", "jszip"],
            "outputPath": {
              "base": "dist/raven",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "*.svg",
                "input": "src/app/modules/record-viewer/assets",
                "output": "assets"
              },
              {
                "glob": "*.svg",
                "input": "src/app/modules/common-ui/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "."
              ]
            },
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "30kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "raven:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "raven:build:production"
            },
            "development": {
              "buildTarget": "raven:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "raven:build"
          }
        }
      }
    },
    "ngx-simple-fhir-models": {
      "projectType": "library",
      "root": "projects/ngx-simple-fhir-models",
      "sourceRoot": "projects/ngx-simple-fhir-models/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-simple-fhir-models/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-simple-fhir-models/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-simple-fhir-models/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "ngx-sfm-mdi": {
      "projectType": "library",
      "root": "projects/ngx-sfm-mdi",
      "sourceRoot": "projects/ngx-sfm-mdi/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-sfm-mdi/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-sfm-mdi/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-sfm-mdi/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
